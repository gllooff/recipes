# recipes backend configuration.
# The systemd unit (deploy/recipes.service) loads this via EnvironmentFile,
# and the binary also reads it as a fallback .env file.

# SQLite database file.
DATABASE_PATH=/opt/recipes/data/recipes.db

# Media files (photos and videos) directory.
MEDIA_DIR=/opt/recipes/data/media

# Static frontend directory.
WEB_DIR=/opt/recipes/web

# Listen address. Loopback only; Caddy terminates TLS and proxies to this.
LISTEN_ADDR=127.0.0.1:8082

# Max upload size in bytes (default 100 MiB).
MAX_UPLOAD_BYTES=104857600

# Session cookie Secure attribute. Must stay true behind HTTPS.
COOKIE_SECURE=true
